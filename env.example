# ==============================================================================
# MARAPOLI (மரபொலி) Environment Configuration
# ==============================================================================
# The system works out-of-the-box for Tamil speech-to-text using
# the built-in Google Speech Recognition engine (ta-IN) with local FFmpeg conversion.
#
# The Tamil Memory Dictionary (தமிழ்ச்சொல் நினைவகம்) and AI Story Summary (மொழி நினைவு)
# use NVIDIA's hosted model API.
# Configure your NVIDIA API key below to enable automated cultural dictionary extraction & summarization:

# NVIDIA Hosted Model API (Tamil Memory Dictionary & AI Story Summary)
# Obtain an API key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq Cloud Whisper API (whisper-large-v3, optional for Tamil oral history)
# Obtain a free API key at: https://console.groq.com/
GROQ_API_KEY=

# Google Gemini API (gemini-1.5-flash multimodal audio, optional)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI Whisper API (whisper-1, optional)
# Obtain a key at: https://platform.openai.com/
OPENAI_API_KEY=

# Flask Secret Key
FLASK_SECRET_KEY=marapoli_tamil_heritage_secret_2026
